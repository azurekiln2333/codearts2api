# codearts2api API Key（只走环境变量，不落盘 git）
CA2A_API_KEY=changeme

# Docker Compose 配置（默认值与原部署一致）
# 改成 21508 即同步修改宿主机端口、容器端口与服务监听，无需改 YAML 或 config.json。
CA2A_PORT=7866
TZ=Asia/Shanghai
CA2A_BUILD_CONTEXT=.
# 构建身份；留空时后台明确显示“未知构建”。更新时填入实际源码提交和 UTC 构建时间。
# CA2A_BUILD_COMMIT=
# CA2A_BUILD_TIME=
CA2A_CONTAINER_NAME=codearts2api
CA2A_RESTART_POLICY=unless-stopped
# 宿主机挂载路径：升级时保留原有目录，避免切换到空凭证目录。
CA2A_AUTHS_PATH=./auths
CA2A_DATA_PATH=./data
CA2A_CONFIG_PATH=./config.json

# 可选应用覆盖：取消注释后也会由 Compose 传入容器；留空沿用 config.json / 内置默认值。
# CA2A_LISTEN 仅用于原生运行；Compose 的监听地址由上面的 CA2A_PORT 统一设置。
# CA2A_LISTEN=:7866
# 下列路径是应用内路径；Docker 中相对路径基于 /app，不是宿主机挂载路径。
# CA2A_AUTH_DIR=./auths
# CA2A_STATE_FILE=./data/state.json
# CA2A_DEFAULT_MODEL=snap-chat
# CA2A_MAX_CONCURRENT=1
# CA2A_MAX_PENDING=64
# CA2A_STARTUP_TIMEOUT_SECONDS=90
# CA2A_ACCOUNT_WAIT_SECONDS=10
# CA2A_UPSTREAM_TIMEOUT_SECONDS=60
# CA2A_STREAM_WRITE_TIMEOUT_SECONDS=30
# CA2A_QUEUE_RETRY_SECONDS=2
# CA2A_QUEUE_MAX_ATTEMPTS=3
# CA2A_KEEPALIVE_WINDOW=10m
# CA2A_WATCH_ENABLED=true
# CA2A_WATCH_POLL_MINUTES=30
# CA2A_WATCH_REFRESH_SKEW=30
# CA2A_WATCH_KEEPALIVE_INTERVAL=15
# CA2A_BENEFIT_AUTO_CLAIM=true
# CA2A_CREDITS_AUTO_CLAIM=true
# CA2A_LOGIN_CLIENT_ID=codearts-agent
# 元数据审计：默认存放在 state_file 同目录下的 audit/，沿用现有 data/ 挂载。
# CA2A_AUDIT_ENABLED=true
# CA2A_AUDIT_DIR=./data/audit
# CA2A_AUDIT_MAX_QUEUE=256
# CA2A_AUDIT_RECENT=512
# CA2A_AUDIT_MAX_FILE_BYTES=8388608
# CA2A_AUDIT_MAX_FILES=8
# CA2A_AUDIT_MAX_TOTAL_BYTES=67108864
# CA2A_AUDIT_RETENTION_DAYS=7
# CA2A_AUDIT_FLUSH_INTERVAL=1s
# 远程授权回调 host（如 https://oneapi.example.com/codearts），留空用本机 127.0.0.1
# CA2A_OAUTH_CALLBACK_HOST=
